@model Schichtplaner.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-heading">
    <span class="brand-mark brand-mark-lg">S</span>
    <h1>Willkommen zurück</h1>
    <p>Melde dich an, um die Dienstplanung zu öffnen.</p>
</div>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="ReturnUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-Mail-Adresse</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Passwort</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Angemeldet bleiben</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Anmelden</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
